{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Plantasonic light theme — Figma semantic Theme 2 (green surface). Regenerate: npm run tokens:import-figma",
  "color": {
    "primary": {
      "default": {
        "$type": "color",
        "$value": "{color.green.500}"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.green.700}"
      },
      "pressed": {
        "$type": "color",
        "$value": "#35722a"
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.neutral.300}"
      }
    },
    "secondary": {
      "$type": "color",
      "$value": "#a83a28"
    },
    "accent": {
      "$type": "color",
      "$value": "#35722a"
    },
    "tint": {
      "mint": {
        "$type": "color",
        "$value": "#ccd6ac",
        "$description": "Pale mint field for bands, menus, footers. 22% primary over surface.app."
      },
      "mint-strong": {
        "$type": "color",
        "$value": "#b8cd9b",
        "$description": "Deeper mint for selected/active fills. 34% primary over surface.app."
      }
    },
    "tone": {
      "sage": {
        "$type": "color",
        "$value": "#7db267",
        "$description": "Sage green for large titles, prices and the logo badge. 70% primary over surface.app."
      },
      "olive": {
        "$type": "color",
        "$value": "#7a6b32",
        "$description": "Olive midpoint between secondary and primary."
      },
      "khaki": {
        "$type": "color",
        "$value": "#5e5328",
        "$description": "Khaki for eyebrows, accordion labels and the primary CTA fill. 72% olive over text.primary."
      },
      "khaki-hover": {
        "$type": "color",
        "$value": "#534a24",
        "$description": "Khaki pressed/hover. 85% khaki over text.primary."
      },
      "on-khaki": {
        "$type": "color",
        "$value": "{color.surface.app}"
      }
    },
    "surface": {
      "default": {
        "$type": "color",
        "$value": "#f0e6cc"
      },
      "app": {
        "$type": "color",
        "$value": "#f0e6cc"
      },
      "stage": {
        "$type": "color",
        "$value": "#0d0d0b"
      },
      "nav": {
        "$type": "color",
        "$value": "#f0e6cc"
      },
      "dock": {
        "$type": "color",
        "$value": "#f0e6cc"
      },
      "input": {
        "$type": "color",
        "$value": "#faf6ea"
      },
      "card": {
        "$type": "color",
        "$value": "#faf6ea"
      },
      "raised": {
        "$type": "color",
        "$value": "#faf6ea"
      },
      "raised-hover": {
        "$type": "color",
        "$value": "#ece2c4"
      },
      "sunken": {
        "$type": "color",
        "$value": "#e3dfd3"
      },
      "overlay": {
        "$type": "color",
        "$value": "#f0e6cc"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#17160f"
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.neutral.700}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.neutral.500}"
      },
      "accent": {
        "$type": "color",
        "$value": "#35722a"
      },
      "link": {
        "$type": "color",
        "$value": "#35722a"
      },
      "inverse": {
        "$type": "color",
        "$value": "#f0e6cc"
      },
      "on-primary": {
        "$type": "color",
        "$value": "#17160f"
      },
      "on-secondary": {
        "$type": "color",
        "$value": "#f0e6cc"
      },
      "on-accent": {
        "$type": "color",
        "$value": "#f0e6cc"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "#c4bda9"
      },
      "subtle": {
        "$type": "color",
        "$value": "#d8d1bd"
      },
      "strong": {
        "$type": "color",
        "$value": "#17160f"
      },
      "interactive": {
        "$type": "color",
        "$value": "#35722a"
      },
      "focus": {
        "$type": "color",
        "$value": "#35722a"
      }
    },
    "overlay": {
      "backdrop": {
        "$type": "color",
        "$value": "rgba(13, 13, 11, 0.45)"
      },
      "scrim-light": {
        "$type": "color",
        "$value": "rgba(23, 22, 15, 0.08)"
      },
      "scrim": {
        "$type": "color",
        "$value": "{color.overlay.scrim-light}"
      },
      "scrim-strong": {
        "$type": "color",
        "$value": "rgba(23, 22, 15, 0.12)"
      },
      "glass": {
        "$type": "color",
        "$value": "rgba(240, 230, 204, 0.85)"
      },
      "focus-outline": {
        "$type": "color",
        "$value": "#17160f"
      }
    },
    "status": {
      "error-surface": {
        "$type": "color",
        "$value": "rgba(178, 59, 42, 0.92)"
      },
      "error-border": {
        "$type": "color",
        "$value": "#17160f"
      }
    }
  },
  "shadow": {
    "none": {
      "$type": "shadow",
      "$value": "none"
    },
    "sm": {
      "$type": "shadow",
      "$value": "0 4px 12px rgba(23, 22, 15, 0.12)"
    },
    "md": {
      "$type": "shadow",
      "$value": "0 8px 24px rgba(23, 22, 15, 0.14)"
    },
    "lg": {
      "$type": "shadow",
      "$value": "0 16px 48px rgba(23, 22, 15, 0.16)"
    },
    "focus": {
      "$type": "shadow",
      "$value": "0 0 0 0.2rem #35722a"
    },
    "glow-accent": {
      "$type": "shadow",
      "$value": "0 0 24px rgba(23, 22, 15, 0.25)"
    },
    "stage-inset": {
      "$type": "shadow",
      "$value": "inset 0 0 48px rgba(0, 0, 0, 0.35)"
    }
  },
  "product": {
    "nav-height": {
      "$type": "dimension",
      "$value": "3.5rem"
    },
    "dock-height": {
      "$type": "dimension",
      "$value": "4.5rem"
    },
    "sidebar-width": {
      "$type": "dimension",
      "$value": "18rem"
    },
    "touch-target": {
      "$type": "dimension",
      "$value": "2.75rem"
    },
    "touch-target-large": {
      "$type": "dimension",
      "$value": "3.25rem"
    },
    "instrument-gutter": {
      "$type": "dimension",
      "$value": "{space.3}"
    },
    "floating-panel-min": {
      "$type": "dimension",
      "$value": "12rem"
    },
    "hud-opacity": {
      "$type": "number",
      "$value": 0.86
    },
    "overlay-radius": {
      "$type": "dimension",
      "$value": "{radius.xl}"
    },
    "preset-card-radius": {
      "$type": "dimension",
      "$value": "{radius.default}"
    },
    "preset-card-border": {
      "$type": "color",
      "$value": "{color.border.default}"
    },
    "preset-card-active-border": {
      "$type": "color",
      "$value": "{color.border.focus}"
    },
    "slider-track": {
      "$type": "color",
      "$value": "{color.surface.input}"
    },
    "slider-thumb": {
      "$type": "color",
      "$value": "{color.primary.default}"
    },
    "stage-border": {
      "$type": "color",
      "$value": "{color.border.default}"
    },
    "performance-chrome-opacity": {
      "$type": "number",
      "$value": 0.92
    },
    "shadow-overlay": {
      "$type": "shadow",
      "$value": "0 16px 48px rgba(0, 0, 0, 0.45)"
    },
    "shadow-sidebar": {
      "$type": "shadow",
      "$value": "4px 0 24px rgba(0, 0, 0, 0.15)"
    },
    "shadow-panel": {
      "$type": "shadow",
      "$value": "{product.shadow-overlay}"
    }
  }
}
